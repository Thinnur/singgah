#!/bin/bash
# project-s5: subnet lab simulasi (netns) + firewall gateway wg0. Dijalankan oleh s5-labs.service.
# Tabel nftables sendiri (ip s5gw); JANGAN "nft flush ruleset" (milik docker/k3s/tailscale).
# Skrip ini hanya memasang kerangka s5gw. Set lab_<id> dan aturan accept per lab (comment "singgah:<lab-id>")
# milik singgah-worker: hilang saat skrip ini dijalankan ulang, lalu dipasang lagi pada siklus worker berikutnya.
# "VM target" .10 tiap lab = container s5-lab-<id> (image singgah-lab-ssh, akun SSH dari berkas yang ditulis worker);
# netns lab-<id> adalah netns container itu (ip netns attach).
# shortcut: container --restart no; bila mati, SSH lab itu mati sampai "systemctl restart s5-labs".
set -euo pipefail
LABS="cloud:192.168.10 cyber:192.168.20 jarkom:192.168.30"   # id lab : 3 oktet pertama subnet /24
IMAGE=${S5_LAB_IMAGE:-singgah-lab-ssh}
ACC_ROOT=/var/lib/singgah/labs     # berkas akun per lab, ditulis singgah-worker (user singgah)
DATA_ROOT=/var/lib/singgah-labs    # home dan host key sshd per lab, tetap saat container dibuat ulang

container_run() {   # container_run <nama> <hostname> <dir akun> <dir home> <dir hostkeys>: satu-satunya tempat flag container lab
	local caps=() c
	for c in CHOWN DAC_OVERRIDE FOWNER SETUID SETGID SYS_CHROOT KILL AUDIT_WRITE NET_BIND_SERVICE; do caps+=(--cap-add "$c"); done
	docker run -d --init --restart no --network none --name "$1" --hostname "$2" \
		--pids-limit 1024 --memory 512m --cpus 1 --cap-drop ALL "${caps[@]}" \
		--security-opt no-new-privileges --sysctl net.ipv4.ping_group_range="0 2147483647" \
		--sysctl net.ipv6.conf.all.disable_ipv6=1 --sysctl net.ipv6.conf.default.disable_ipv6=1 \
		-v "$3:/run/singgah:ro" -v "$4:/home" -v "$5:/etc/ssh/hostkeys" "$IMAGE"
}

docker_rules() {   # docker_rules -D|-I
	if [ "$1" = -D ]; then
		while iptables -D DOCKER-USER -i wg0 -o s5-+ -j ACCEPT 2>/dev/null; do :; done
		while iptables -D DOCKER-USER -i s5-+ -o wg0 -j ACCEPT 2>/dev/null; do :; done
	else
		iptables -I DOCKER-USER -i wg0 -o s5-+ -j ACCEPT
		iptables -I DOCKER-USER -i s5-+ -o wg0 -j ACCEPT
	fi
}

down() {
	local id
	for l in $LABS; do
		id=${l%%:*}
		ip netns del "lab-$id" 2>/dev/null || true
		docker rm -f "s5-lab-$id" >/dev/null 2>&1 || true   # netns container hilang, veth ikut terhapus
	done
	nft delete table ip s5gw 2>/dev/null || true
	docker_rules -D
}

up() {
	# 1. Firewall dulu, satu transaksi atomik (buat-hapus-buat): wg0 tidak pernah tanpa filter,
	#    juga bila langkah netns di bawah gagal. Set dan aturan lab milik worker ikut terhapus.
	nft -f - <<-EOF
	table ip s5gw
	delete table ip s5gw
	table ip s5gw {
		chain forward {
			type filter hook forward priority filter - 10; policy accept;
			ct state established,related accept
			iifname "wg0" drop
			oifname "wg0" drop
		}
		chain input {
			type filter hook input priority filter - 10; policy accept;
			iifname "wg0" ct state established,related accept
			iifname "wg0" ip daddr 10.8.0.1 icmp type echo-request accept
			iifname "wg0" ip daddr 10.8.0.1 meta l4proto { udp, tcp } th dport 53 accept   # Bind9 (DNS lab.internal)
			iifname "wg0" drop
			# container lab (veth s5-*) punya shell mahasiswa: tidak boleh membuka koneksi ke layanan laptop
			# (sshd, k3s, kubelet, ...). Tabel ini hanya IPv4; IPv6 dimatikan di container (container_run).
			iifname "s5-*" ct state established,related accept
			iifname "s5-*" drop
			# singgah-api (port 8780) hanya dari localhost (nginx) dan relay VPS (jalur lama, untuk rollback rute tunnel)
			tcp dport 8780 iifname "lo" accept
			tcp dport 8780 ip saddr 100.68.122.86 accept
			tcp dport 8780 drop
		}
	}
	EOF
	# 2. Docker men-DROP forwarding bawaan; kebijakan sebenarnya ditegakkan tabel s5gw di atas.
	docker_rules -D
	docker_rules -I
	# 3. Container + netns lab, dibuat ulang per lab. Veth dihapus dulu (sinkron, dua ujung): bisa tertinggal bila ada
	#    proses di netns lama, lalu "ip link add" gagal "File exists".
	local id net pid
	install -d -o singgah -g singgah -m 0755 "$ACC_ROOT"   # worker juga membuat dir lab yang ditambah admin
	for l in $LABS; do
		id=${l%%:*} net=${l#*:}
		install -d -o singgah -g singgah -m 0755 "$ACC_ROOT/lab-$id"
		install -d -m 0755 "$DATA_ROOT/lab-$id/home"
		install -d -m 0700 "$DATA_ROOT/lab-$id/hostkeys"
		ip link del "s5-$id" 2>/dev/null || true
		ip netns del "lab-$id" 2>/dev/null || true
		docker rm -f "s5-lab-$id" >/dev/null 2>&1 || true
		# container gagal (Docker belum siap, image hilang, entrypoint mati) -> netns biasa tanpa SSH,
		# supaya VPN dan halaman uji lab tetap jalan
		if ! container_run "s5-lab-$id" "lab-$id" "$ACC_ROOT/lab-$id" "$DATA_ROOT/lab-$id/home" "$DATA_ROOT/lab-$id/hostkeys" >/dev/null ||
			! pid=$(docker inspect -f '{{.State.Pid}}' "s5-lab-$id") || [ "$pid" = 0 ] || ! ip netns attach "lab-$id" "$pid"; then
			echo "lab-$id: container gagal, netns tanpa SSH" >&2
			docker rm -f "s5-lab-$id" >/dev/null 2>&1 || true
			ip netns del "lab-$id" 2>/dev/null || true
			ip netns add "lab-$id"
		fi
		ip link add "s5-$id" type veth peer name eth0 netns "lab-$id"
		ip addr add "$net.1/24" dev "s5-$id"
		ip link set "s5-$id" up
		ip -n "lab-$id" addr add "$net.10/24" dev eth0   # "VM target" lab
		ip -n "lab-$id" link set lo up
		ip -n "lab-$id" link set eth0 up
		ip -n "lab-$id" route add 10.8.0.0/24 via "$net.1"
	done
}

case "${1:-}" in
	up) up ;;
	down) down ;;
	container-run) shift; container_run "$@" ;;   # dipakai lab-ssh/test-image.sh
	*) echo "pakai: $0 up|down" >&2; exit 2 ;;
esac
