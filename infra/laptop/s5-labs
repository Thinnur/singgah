#!/bin/bash
# project-s5: subnet lab simulasi (netns) + firewall gateway wg0. Dijalankan oleh s5-labs.service.
# Tabel nftables sendiri (ip s5gw); JANGAN "nft flush ruleset" (milik docker/k3s/tailscale).
# Skrip ini hanya memasang kerangka s5gw. Set lab_<id> dan aturan accept per lab (comment "singgah:<lab-id>")
# milik singgah-worker: hilang saat skrip ini dijalankan ulang, lalu dipasang lagi pada siklus worker berikutnya.
set -euo pipefail
LABS="cloud:192.168.10 cyber:192.168.20 jarkom:192.168.30"   # id lab : 3 oktet pertama subnet /24

docker_rules() {   # docker_rules -D|-I
	if [ "$1" = -D ]; then
		while iptables -D DOCKER-USER -i wg0 -o s5-+ -j ACCEPT 2>/dev/null; do :; done
		while iptables -D DOCKER-USER -i s5-+ -o wg0 -j ACCEPT 2>/dev/null; do :; done
	else
		iptables -I DOCKER-USER -i wg0 -o s5-+ -j ACCEPT
		iptables -I DOCKER-USER -i s5-+ -o wg0 -j ACCEPT
	fi
}

down() {
	for l in $LABS; do ip netns del "lab-${l%%:*}" 2>/dev/null || true; done   # veth ikut terhapus
	nft delete table ip s5gw 2>/dev/null || true
	docker_rules -D
}

up() {
	# 1. Firewall dulu, satu transaksi atomik (buat-hapus-buat): wg0 tidak pernah tanpa filter,
	#    juga bila langkah netns di bawah gagal. Set dan aturan lab milik worker ikut terhapus.
	nft -f - <<-EOF
	table ip s5gw
	delete table ip s5gw
	table ip s5gw {
		chain forward {
			type filter hook forward priority filter - 10; policy accept;
			ct state established,related accept
			iifname "wg0" drop
			oifname "wg0" drop
		}
		chain input {
			type filter hook input priority filter - 10; policy accept;
			iifname "wg0" ct state established,related accept
			iifname "wg0" ip daddr 10.8.0.1 icmp type echo-request accept
			iifname "wg0" drop
			# singgah-api (port 8780) hanya dari localhost dan relay VPS: API mempercayai header CF-Connecting-IP
			tcp dport 8780 iifname "lo" accept
			tcp dport 8780 ip saddr 100.68.122.86 accept
			tcp dport 8780 drop
		}
	}
	EOF
	# 2. Docker men-DROP forwarding bawaan; kebijakan sebenarnya ditegakkan tabel s5gw di atas.
	docker_rules -D
	docker_rules -I
	# 3. Netns lab, dibuat ulang per lab. Veth dihapus dulu (sinkron, dua ujung): bisa tertinggal bila ada proses
	#    di netns lama, lalu "ip link add" gagal "File exists".
	local id net
	for l in $LABS; do
		id=${l%%:*} net=${l#*:}
		ip link del "s5-$id" 2>/dev/null || true
		ip netns del "lab-$id" 2>/dev/null || true
		ip netns add "lab-$id"
		ip link add "s5-$id" type veth peer name eth0 netns "lab-$id"
		ip addr add "$net.1/24" dev "s5-$id"
		ip link set "s5-$id" up
		ip -n "lab-$id" addr add "$net.10/24" dev eth0   # "VM target" lab
		ip -n "lab-$id" link set lo up
		ip -n "lab-$id" link set eth0 up
		ip -n "lab-$id" route add 10.8.0.0/24 via "$net.1"
	done
}

case "${1:-}" in
	up) up ;;
	down) down ;;
	*) echo "pakai: $0 up|down" >&2; exit 2 ;;
esac
