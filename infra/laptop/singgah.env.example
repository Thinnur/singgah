# Konfigurasi Singgah: /etc/singgah/singgah.env (root:singgah 0640). Dibaca singgah-api dan singgah-worker.
# install.sh menyalin file ini bila belum ada. Variabel yang diberikan ke install.sh lewat environment
# menimpa nilai di sini, mis.: sudo TEST_MODE=1 PUBLIC_URL=http://localhost:8780 bash install.sh
# Rahasia (GOOGLE_CLIENT_SECRET) hanya diisi di laptop, jangan pernah di-commit.

# 1 = mode uji: durasi 1 menit, POST /auth/test-login (hanya loopback), variabel Google boleh kosong.
TEST_MODE=0
# Alamat publik portal (dipakai untuk redirect OAuth dan cookie Secure).
PUBLIC_URL=https://singgah.akzara.id
# Port API. Chain input s5gw (s5-labs) hanya membuka port ini untuk lo dan relay VPS; ubah keduanya bersamaan.
PORT=8780
DB_PATH=/var/lib/singgah/singgah.db

# OAuth Client (Web application) dari Google Cloud Console, redirect URI <PUBLIC_URL>/auth/callback.
# Wajib diisi bila TEST_MODE=0.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Daftar email dipisah koma, tanpa spasi. ADMIN_EMAILS = peran admin (dihitung ulang tiap login).
# Identitas uji @singgah.invalid tidak mungkin lolos verifikasi Google, hanya bisa lewat test-login (TEST_MODE=1);
# `s5-selftest --api` mewajibkannya. Go-live: ganti dengan admin sungguhan, lalu kosongkan tabel sessions (README).
ADMIN_EMAILS=selftest-admin@singgah.invalid
# Email di luar @mail.ugm.ac.id / @ugm.ac.id yang tetap boleh masuk (cadangan bila Workspace UGM memblokir).
EXTRA_ALLOWED_EMAILS=selftest-admin@singgah.invalid,selftest-api@singgah.invalid

# Kuota harian per pengguna (jam, hari kalender WIB).
DAILY_QUOTA_HOURS=8
# Jeda siklus rekonsiliasi worker (detik). 4, bukan bawaan 5: aktivasi peer harus <= 5 dtk (PRD 3.2),
# satu siklus + waktu proses bisa melewati 5 dtk. PRD 4.1 membolehkan nilai ini diatur.
RECONCILE_INTERVAL_S=4
# berkas akun SSH per lab yang dibaca container lab (bawaan /var/lib/singgah/labs)
# LAB_ACCOUNTS_DIR=/var/lib/singgah/labs

# WireGuard gateway. Pubkey = `wg show wg0 public-key`; endpoint = alamat yang dipakai klien (relay VPS).
WG_INTERFACE=wg0
WG_SERVER_PUBKEY=DEgt5zLQb88/fJzae0f/U+kdcPmgWkyzWwwYJ7UtM2Y=
WG_ENDPOINT=103.93.133.235:51820
# IP Tailscale relay VPS: satu-satunya sumber yang header CF-Connecting-IP-nya dipercaya.
TRUSTED_PROXY_IP=100.68.122.86
